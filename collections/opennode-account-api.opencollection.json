{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenNode Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opennode.com/v1/account/balance"
          },
          "docs": "Retrieves the current balance for the authenticated merchant account, including Bitcoin and fiat holdings."
        }
      ]
    }
  ],
  "bundled": true
}