          "name": "Create a charge",
          "request": {
            "name": "Create a charge",
            "description": {
              "content": "Creates a new Bitcoin payment charge. Returns a Lightning Network BOLT11 invoice and an on-chain Bitcoin address for the customer to pay. Webhooks notify the merchant upon payment confirmation.\n",
              "type": "text/plain"
            },
